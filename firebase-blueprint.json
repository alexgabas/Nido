{
  "entities": {
    "UserHouseholdLink": {
      "title": "UserHouseholdLink",
      "description": "Maps a user UID to their active household ID.",
      "type": "object",
      "properties": {
        "householdId": {
          "type": "string",
          "description": "Active household document ID or empty string if unlinked.",
          "maxLength": 128
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["householdId", "updatedAt"]
    },
    "InviteCode": {
      "title": "InviteCode",
      "description": "Six-character invite code resolving to a household.",
      "type": "object",
      "properties": {
        "householdId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "householdName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "memberCount": {
          "type": "integer",
          "description": "Current number of members in the linked household (1 or 2)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["householdId", "householdName", "createdBy", "memberCount", "createdAt"]
    },
    "Household": {
      "title": "Household",
      "description": "Shared couple household with up to 2 members and split configuration.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "memberUids": {
          "type": "array",
          "description": "UIDs of the 1 or 2 household members."
        },
        "inviteCode": {
          "type": "string",
          "minLength": 6,
          "maxLength": 6,
          "pattern": "^[A-Z0-9]{6}$"
        },
        "settings": {
          "type": "object",
          "description": "Split configuration and currency settings."
        },
        "incomeConfig": {
          "type": ["object", "null"],
          "description": "Optional detailed net income configuration (quick vs detailed with ordinary paychecks, extra paychecks, and other incomes) per member.",
          "properties": {
            "memberA": { "type": "object" },
            "memberB": { "type": "object" },
            "updatedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
            "updatedAt": { "type": "string", "minLength": 1, "maxLength": 64 }
          },
          "required": ["memberA", "memberB", "updatedBy", "updatedAt"],
          "additionalProperties": false
        },
        "habitualSavingsPlan": {
          "type": ["object", "null"],
          "description": "Optional recurring household habitual savings plan with manual monthly target and goal priority order.",
          "properties": {
            "monthlyAmount": { "type": "number", "minimum": 0 },
            "priorityGoalIds": {
              "type": "array",
              "maxItems": 50,
              "items": { "type": "string", "minLength": 1, "maxLength": 128 }
            },
            "updatedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
            "updatedAt": { "type": "string", "minLength": 1, "maxLength": 64 }
          },
          "required": ["monthlyAmount", "priorityGoalIds", "updatedBy", "updatedAt"],
          "additionalProperties": false
        },
        "csvKeywords": {
          "type": "object",
          "description": "Optional comma-separated keyword rules keyed by the 13 ExpenseCategory keys for bank CSV auto-categorization.",
          "properties": {
            "alquiler": { "type": "string", "maxLength": 300 },
            "luz": { "type": "string", "maxLength": 300 },
            "agua": { "type": "string", "maxLength": 300 },
            "gas": { "type": "string", "maxLength": 300 },
            "internet": { "type": "string", "maxLength": 300 },
            "movil": { "type": "string", "maxLength": 300 },
            "suscripciones": { "type": "string", "maxLength": 300 },
            "seguros": { "type": "string", "maxLength": 300 },
            "comunidad": { "type": "string", "maxLength": 300 },
            "supermercado": { "type": "string", "maxLength": 300 },
            "transporte": { "type": "string", "maxLength": 300 },
            "ocio": { "type": "string", "maxLength": 300 },
            "otros": { "type": "string", "maxLength": 300 }
          },
          "additionalProperties": false
        },
        "categoryColors": {
          "type": "object",
          "description": "Optional shared hex color overrides keyed by the 13 ExpenseCategory keys.",
          "properties": {
            "alquiler": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
            "luz": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
            "agua": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
            "gas": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
            "internet": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
            "movil": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
            "suscripciones": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
            "seguros": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
            "comunidad": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
            "supermercado": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
            "transporte": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
            "ocio": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
            "otros": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
          },
          "additionalProperties": false
        },
        "commonAccountPlannedCategories": {
          "type": "array",
          "maxItems": 60,
          "description": "Optional shared household preference listing category IDs whose variable budget margin is planned to be funded from the Common Account.",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "commonAccountManualBalance": {
          "type": ["object", "null"],
          "description": "Optional manually reported available balance of the Common Account with explicit reference date and author.",
          "properties": {
            "amount": { "type": "number", "minimum": 0 },
            "referenceDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "updatedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
            "updatedAt": { "type": "string", "minLength": 1, "maxLength": 64 }
          },
          "required": ["amount", "referenceDate", "updatedBy", "updatedAt"],
          "additionalProperties": false
        },
        "mudanzaCompleted": {
          "type": "boolean",
          "description": "Optional shared household flag marking the moving stage as completed (reversible; absent defaults to false)."
        },
        "mudanzaCompletedAt": {
          "type": ["string", "null"],
          "maxLength": 64,
          "description": "Optional ISO timestamp recording when the moving stage was marked completed."
        },
        "mudanzaCompletedBy": {
          "type": ["string", "null"],
          "maxLength": 128,
          "description": "Optional UID of the member who marked the moving stage as completed."
        },
        "seedPending": {
          "type": "boolean",
          "description": "True while Phase B default seeds (including inactive recurring catalog) are pending completion."
        },
        "recurringSeedVersion": {
          "type": "integer",
          "minimum": 0,
          "description": "Version of the default recurring expense catalog already seeded for this household."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["name", "memberUids", "inviteCode", "settings", "createdAt", "updatedAt"]
    },
    "Member": {
      "title": "Member",
      "description": "Household member profile and UI mode preference.",
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500
        },
        "role": {
          "type": "string",
          "enum": ["member_a", "member_b"]
        },
        "uiMode": {
          "type": "string",
          "enum": ["sencillo", "avanzado"]
        },
        "joinedAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["displayName", "photoURL", "role", "uiMode", "joinedAt", "updatedAt"]
    },
    "ActivityEntry": {
      "title": "ActivityEntry",
      "description": "Immutable audit log entry for household changes.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "actorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "action": {
          "type": "string",
          "enum": ["create", "update", "delete", "close_month", "reopen_month", "join", "import"]
        },
        "entity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "entityId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "actorName", "action", "entity", "entityId", "summary", "timestamp"]
    },
    "InitialCost": {
      "title": "InitialCost",
      "description": "One-off moving and rental setup expense.",
      "type": "object",
      "properties": {
        "concept": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "description": "System InitialCostCategory enum OR household custom category ID (cat_*)."
        },
        "amount": {
          "type": "number"
        },
        "paidBy": {
          "type": "string",
          "description": "Household member UID or 'cuenta_comun'.",
          "minLength": 1,
          "maxLength": 128
        },
        "status": {
          "type": "string",
          "enum": ["pendiente", "pagado"]
        },
        "dueDate": {
          "type": "string",
          "maxLength": 10
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["concept", "category", "amount", "paidBy", "status", "dueDate", "notes", "createdAt", "updatedAt"]
    },
    "ChecklistItem": {
      "title": "ChecklistItem",
      "description": "Catalunya rental moving checklist task.",
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "done": {
          "type": "boolean"
        },
        "doneBy": {
          "type": "string",
          "maxLength": 128
        },
        "doneAt": {
          "type": "string",
          "maxLength": 32
        },
        "group": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "order": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["text", "done", "doneBy", "doneAt", "group", "order", "createdAt", "updatedAt"]
    },
    "FurnitureItem": {
      "title": "FurnitureItem",
      "description": "Furniture or appliance item to equip the home.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "room": {
          "type": "string",
          "enum": ["salon", "dormitorio", "cocina", "baño", "entrada", "terraza", "otros"]
        },
        "priority": {
          "type": "string",
          "enum": ["imprescindible", "pronto", "algun_dia"]
        },
        "status": {
          "type": "string",
          "enum": ["ya_lo_tenemos", "pendiente", "en_carrito", "comprado"]
        },
        "store": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "productUrl": {
          "type": "string",
          "maxLength": 500
        },
        "articleNumber": {
          "type": "string",
          "maxLength": 40
        },
        "unitPrice": {
          "type": "number"
        },
        "qty": {
          "type": "number"
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["name", "room", "priority", "status", "store", "productUrl", "articleNumber", "unitPrice", "qty", "notes", "createdAt", "updatedAt"]
    },
    "RecurringExpense": {
      "title": "RecurringExpense",
      "description": "Recurring expense template (monthly, bimonthly, quarterly, annual).",
      "type": "object",
      "properties": {
        "concept": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "description": "System ExpenseCategory enum OR household custom category ID (cat_*)."
        },
        "amount": {
          "type": "number"
        },
        "frequency": {
          "type": "string",
          "enum": ["mensual", "bimestral", "trimestral", "anual"]
        },
        "dayOfMonth": {
          "type": "number"
        },
        "startMonth": {
          "type": "string",
          "pattern": "^(\\d{4}-\\d{2})?$",
          "maxLength": 7
        },
        "skippedMonths": {
          "type": "array",
          "maxItems": 120,
          "description": "Optional sorted list of YYYY-MM month keys where this template did not occur without deactivating the template.",
          "items": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}$",
            "maxLength": 7
          }
        },
        "splitOverride": {
          "type": "number"
        },
        "paidByDefault": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "active": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["concept", "category", "amount", "frequency", "dayOfMonth", "paidByDefault", "active", "createdAt", "updatedAt"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Monthly expense or couple settlement transaction.",
      "type": "object",
      "properties": {
        "monthKey": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}$",
          "maxLength": 7
        },
        "concept": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "description": "System ExpenseCategory enum, 'liquidacion', OR household custom category ID (cat_*)."
        },
        "amount": {
          "type": "number"
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "maxLength": 10
        },
        "paidBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "recurringId": {
          "type": "string",
          "maxLength": 128
        },
        "splitPctA": {
          "type": "number"
        },
        "isSettlement": {
          "type": "boolean"
        },
        "settlementTo": {
          "type": "string",
          "maxLength": 128
        },
        "isPrivate": {
          "type": "boolean",
          "description": "True when the expense is personal and visible only to createdBy."
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "UID of the household member who created the transaction."
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["monthKey", "concept", "category", "amount", "date", "paidBy", "recurringId", "splitPctA", "isSettlement", "settlementTo", "isPrivate", "createdBy", "notes", "createdAt", "updatedAt"]
    },
    "MonthlyBudget": {
      "title": "MonthlyBudget",
      "description": "Category budget limits for a specific month.",
      "type": "object",
      "properties": {
        "monthKey": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}$",
          "maxLength": 7
        },
        "limits": {
          "type": "object",
          "description": "Map of known ExpenseCategory keys to non-negative monthly EUR limits.",
          "properties": {
            "alquiler": { "type": "number" },
            "luz": { "type": "number" },
            "agua": { "type": "number" },
            "gas": { "type": "number" },
            "internet": { "type": "number" },
            "movil": { "type": "number" },
            "suscripciones": { "type": "number" },
            "seguros": { "type": "number" },
            "comunidad": { "type": "number" },
            "supermercado": { "type": "number" },
            "transporte": { "type": "number" },
            "ocio": { "type": "number" },
            "otros": { "type": "number" }
          },
          "additionalProperties": false
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["monthKey", "limits", "updatedAt"]
    },
    "MonthClosure": {
      "title": "MonthClosure",
      "description": "Closed month snapshot locking edits unless unlocked.",
      "type": "object",
      "properties": {
        "monthKey": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}$",
          "maxLength": 7
        },
        "totalSpent": { "type": "number" },
        "paidA": { "type": "number" },
        "paidB": { "type": "number" },
        "paidComun": { "type": "number" },
        "shareA": { "type": "number" },
        "shareB": { "type": "number" },
        "balanceA": { "type": "number" },
        "settlementText": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "closedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "closedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["monthKey", "totalSpent", "paidA", "paidB", "paidComun", "shareA", "shareB", "balanceA", "settlementText", "closedBy", "closedAt"]
    },
    "SavingsGoal": {
      "title": "SavingsGoal",
      "description": "Couple savings goal with optional target date.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "icon": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "color": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "targetAmount": { "type": "number" },
        "targetDate": {
          "type": "string",
          "maxLength": 10
        },
        "type": {
          "type": "string",
          "enum": ["navidad", "viajes", "cumpleaños", "ahorro_comun", "emergencia", "custom"]
        },
        "archived": { "type": "boolean" },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["name", "icon", "color", "targetAmount", "targetDate", "type", "archived", "createdAt", "updatedAt"]
    },
    "GoalMovement": {
      "title": "GoalMovement",
      "description": "Deposit (+) or withdrawal (-) movement for a savings goal.",
      "type": "object",
      "properties": {
        "goalId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "amount": { "type": "number" },
        "by": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "maxLength": 10
        },
        "note": {
          "type": "string",
          "maxLength": 240
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["goalId", "amount", "by", "date", "note", "createdAt"]
    },
    "ShoppingItem": {
      "title": "ShoppingItem",
      "description": "Shared household shopping list item synced in real time.",
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "qty": {
          "type": "number",
          "description": "Positive quantity in (0, 999], allowing decimals such as 0.5 kg."
        },
        "unit": {
          "type": "string",
          "maxLength": 20,
          "description": "Optional measurement unit (ud, kg, g, L, paq, etc.)."
        },
        "done": {
          "type": "boolean"
        },
        "catalogId": {
          "type": "string",
          "maxLength": 48,
          "description": "Optional stable ID linking to external static Mercadona catalog."
        },
        "brand": {
          "type": "string",
          "maxLength": 60,
          "description": "Optional brand name (e.g. Hacendado, Deliplus)."
        },
        "format": {
          "type": "string",
          "maxLength": 40,
          "description": "Optional pack/content format (e.g. 1 L, 500 g)."
        },
        "section": {
          "type": "string",
          "maxLength": 48,
          "enum": [
            "",
            "Fruta y verdura",
            "Carne, charcutería y huevos",
            "Pescado y marisco",
            "Lácteos, quesos y bebidas vegetales",
            "Panadería y bollería",
            "Despensa, arroz, pasta y conservas",
            "Desayuno, café y dulces",
            "Congelados",
            "Platos preparados y refrigerados",
            "Bebidas",
            "Limpieza y hogar",
            "Cuidado personal e higiene",
            "Bebé y mascotas",
            "Otros de supermercado",
            "Sin clasificar"
          ]
        },
        "sourceType": {
          "type": "string",
          "enum": ["", "mercadona", "custom", "generic"]
        },
        "addedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["text", "qty", "done", "addedBy", "createdAt", "updatedAt"]
    },
    "CustomCategory": {
      "title": "CustomCategory",
      "description": "Household-scoped custom expense category with shared color, icon, order, archive flag, and CSV keywords.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "icon": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "order": {
          "type": "number",
          "minimum": 0,
          "maximum": 999
        },
        "archived": {
          "type": "boolean"
        },
        "csvKeywords": {
          "type": "string",
          "maxLength": 300
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["name", "color", "icon", "order", "archived", "csvKeywords", "createdAt", "updatedAt"]
    },
    "CategoryBudgetLimit": {
      "title": "CategoryBudgetLimit",
      "description": "Monthly budget limit for a custom expense category, keyed by YYYY-MM__cat_id.",
      "type": "object",
      "properties": {
        "monthKey": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}$",
          "maxLength": 7
        },
        "categoryId": {
          "type": "string",
          "pattern": "^cat_[a-zA-Z0-9_]{2,44}$"
        },
        "limit": {
          "type": "number",
          "minimum": 0
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["monthKey", "categoryId", "limit", "updatedAt"]
    },
    "ShoppingCatalogItem": {
      "title": "ShoppingCatalogItem",
      "description": "Household product reference, favorites, and recents synced compactly for zero-cost autocomplete.",
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "defaultUnit": {
          "type": "string",
          "maxLength": 20
        },
        "usageCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "lastUsedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "favorite": {
          "type": "boolean"
        },
        "catalogId": {
          "type": "string",
          "maxLength": 48
        },
        "brand": {
          "type": "string",
          "maxLength": 60
        },
        "format": {
          "type": "string",
          "maxLength": 40
        },
        "section": {
          "type": "string",
          "maxLength": 48
        },
        "sourceType": {
          "type": "string",
          "enum": ["", "mercadona", "custom", "generic"]
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["text", "defaultUnit", "usageCount", "lastUsedAt", "createdBy", "createdAt", "updatedAt"]
    },
    "PendingShoppingCheckout": {
      "title": "PendingShoppingCheckout",
      "description": "Temporary coordination record for multi-batch durable shopping list cleanup after atomic expense creation; deleted when cleanup completes.",
      "type": "object",
      "properties": {
        "expenseId": {
          "type": "string",
          "pattern": "^tx_chk_[a-zA-Z0-9_]{6,40}$"
        },
        "monthKey": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}$",
          "maxLength": 7
        },
        "amount": {
          "type": "number",
          "minimum": 0
        },
        "concept": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "pendingItemIds": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "maxItems": 100
        },
        "totalItemCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "isPrivate": {
          "type": "boolean"
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["expenseId", "monthKey", "amount", "concept", "pendingItemIds", "totalItemCount", "isPrivate", "createdBy", "createdAt", "updatedAt"]
    },
    "MemberCategoryPreferences": {
      "title": "MemberCategoryPreferences",
      "description": "Private per-member visible categories and order for the expense category selector.",
      "type": "object",
      "properties": {
        "selectorVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "visibleCategoryIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 2, "maxLength": 48 },
          "maxItems": 60
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["selectorVersion", "visibleCategoryIds", "updatedAt"]
    },
    "ShoppingListTemplate": {
      "title": "ShoppingListTemplate",
      "description": "Shared reusable household shopping list template.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "items": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "properties": {
              "text": { "type": "string", "minLength": 1, "maxLength": 120 },
              "qty": { "type": "number" },
              "unit": { "type": "string", "maxLength": 20 },
              "catalogId": { "type": "string", "maxLength": 48 },
              "brand": { "type": "string", "maxLength": 60 },
              "format": { "type": "string", "maxLength": 40 },
              "section": { "type": "string", "maxLength": 48 },
              "sourceType": { "type": "string", "enum": ["", "mercadona", "custom", "generic"] }
            },
            "required": ["text", "qty"]
          }
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["name", "items", "createdBy", "createdAt", "updatedAt"]
    },
    "ShoppingSectionOverride": {
      "title": "ShoppingSectionOverride",
      "description": "Shared household supermarket section override keyed by stable productKey.",
      "type": "object",
      "properties": {
        "productKey": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]{2,64}$"
        },
        "section": {
          "type": "string",
          "enum": [
            "Fruta y verdura",
            "Carne, charcutería y huevos",
            "Pescado y marisco",
            "Lácteos, quesos y bebidas vegetales",
            "Panadería y bollería",
            "Despensa, arroz, pasta y conservas",
            "Desayuno, café y dulces",
            "Congelados",
            "Platos preparados y refrigerados",
            "Bebidas",
            "Limpieza y hogar",
            "Cuidado personal e higiene",
            "Bebé y mascotas",
            "Otros de supermercado",
            "Sin clasificar"
          ]
        },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["productKey", "section", "updatedBy", "updatedAt"]
    },
    "MonthlySavingsPlan": {
      "title": "MonthlySavingsPlan",
      "description": "Shared household monthly savings plan keyed by YYYY-MM with manual target amount and ordered goal allocations (no calculated totals persisted).",
      "type": "object",
      "properties": {
        "monthKey": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}$",
          "minLength": 7,
          "maxLength": 7
        },
        "targetAmount": {
          "type": "number",
          "description": "Manual target amount (>= 0) reserved by the couple for the month."
        },
        "allocations": {
          "type": "array",
          "description": "Ordered allocations by goalId (max 50 items).",
          "maxItems": 50
        },
        "adjustmentKind": {
          "type": "string",
          "enum": ["ajuste", "extra"],
          "description": "Optional indicator distinguishing a monthly adjustment from an explicit extra savings addition."
        },
        "extraAmount": {
          "type": "number",
          "minimum": 0,
          "description": "Optional explicit extra savings amount added on top of the month base plan."
        },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["monthKey", "targetAmount", "allocations", "updatedBy", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": { "$ref": "#/entities/UserHouseholdLink" },
      "description": "Private user link to current household."
    },
    "/invites/{inviteCode}": {
      "schema": { "$ref": "#/entities/InviteCode" },
      "description": "Lookup index from 6-character invite code to householdId."
    },
    "/households/{hid}": {
      "schema": { "$ref": "#/entities/Household" },
      "description": "Shared couple household root document."
    },
    "/households/{hid}/members/{uid}": {
      "schema": { "$ref": "#/entities/Member" },
      "description": "Household members (max 2)."
    },
    "/households/{hid}/activity/{id}": {
      "schema": { "$ref": "#/entities/ActivityEntry" },
      "description": "Audit log of changes within the household."
    },
    "/households/{hid}/initialCosts/{id}": {
      "schema": { "$ref": "#/entities/InitialCost" },
      "description": "Initial moving and rental setup costs."
    },
    "/households/{hid}/checklist/{id}": {
      "schema": { "$ref": "#/entities/ChecklistItem" },
      "description": "Catalunya rental moving checklist."
    },
    "/households/{hid}/items/{id}": {
      "schema": { "$ref": "#/entities/FurnitureItem" },
      "description": "Furniture and appliances list."
    },
    "/households/{hid}/recurring/{id}": {
      "schema": { "$ref": "#/entities/RecurringExpense" },
      "description": "Recurring expense templates."
    },
    "/households/{hid}/transactions/{id}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "Monthly expenses and couple settlements."
    },
    "/households/{hid}/budgets/{monthKey}": {
      "schema": { "$ref": "#/entities/MonthlyBudget" },
      "description": "Monthly system category budgets keyed by YYYY-MM."
    },
    "/households/{hid}/categoryBudgets/{docId}": {
      "schema": { "$ref": "#/entities/CategoryBudgetLimit" },
      "description": "Monthly budget limits for custom household categories keyed by YYYY-MM__cat_id."
    },
    "/households/{hid}/categories/{catId}": {
      "schema": { "$ref": "#/entities/CustomCategory" },
      "description": "Custom expense categories scoped to the household."
    },
    "/households/{hid}/monthClosures/{monthKey}": {
      "schema": { "$ref": "#/entities/MonthClosure" },
      "description": "Monthly closure snapshots keyed by YYYY-MM."
    },
    "/households/{hid}/goals/{id}": {
      "schema": { "$ref": "#/entities/SavingsGoal" },
      "description": "Couple savings goals."
    },
    "/households/{hid}/goalMovements/{id}": {
      "schema": { "$ref": "#/entities/GoalMovement" },
      "description": "Deposits and withdrawals on savings goals."
    },
    "/households/{hid}/savingsPlans/{monthKey}": {
      "schema": { "$ref": "#/entities/MonthlySavingsPlan" },
      "description": "Shared monthly savings plans per household keyed by YYYY-MM."
    },
    "/households/{hid}/shopping/{id}": {
      "schema": { "$ref": "#/entities/ShoppingItem" },
      "description": "Shared household shopping list items."
    },
    "/households/{hid}/shoppingCatalog/{prodId}": {
      "schema": { "$ref": "#/entities/ShoppingCatalogItem" },
      "description": "Household reusable product catalog for shopping autocomplete."
    },
    "/households/{hid}/shoppingCheckouts/{checkoutId}": {
      "schema": { "$ref": "#/entities/PendingShoppingCheckout" },
      "description": "Temporary multi-batch shopping checkout cleanup recovery state (deleted when complete)."
    },
    "/households/{hid}/memberPreferences/{uid}": {
      "schema": { "$ref": "#/entities/MemberCategoryPreferences" },
      "description": "Per-member private category visibility and order preferences for the expense selector."
    },
    "/households/{hid}/shoppingTemplates/{tplId}": {
      "schema": { "$ref": "#/entities/ShoppingListTemplate" },
      "description": "Shared reusable household shopping lists."
    },
    "/households/{hid}/shoppingSectionOverrides/{overrideId}": {
      "schema": { "$ref": "#/entities/ShoppingSectionOverride" },
      "description": "Household-scoped supermarket section overrides for specific products."
    }
  }
}
